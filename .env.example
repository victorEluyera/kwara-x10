# Session signing secret. Set a long random value in production.
KWARA_SECRET=change-me-to-a-long-random-string

# Port the API listens on.
PORT=4000

# Bank account name resolution (Paystack). See docs/DATA-SOURCES.md
# PAYSTACK_SECRET_KEY=sk_live_xxxxx

# NIN verification through a licensed KYC aggregator.
# KYC_PROVIDER=dojah
# KYC_API_KEY=xxxxx
# KYC_APP_ID=xxxxx

# Demonstration mode: makes the two paid lookups (NIN, bank name) return
# plausible results so the workflow can be shown without provider accounts.
# Every simulated result is labelled in the UI. Leave unset in production.
# VERIFY_MODE=simulate

# Where uploaded field-evidence photos are stored. On a host with a persistent
# volume, point this at the mounted path (e.g. /data/uploads).
# KWARA_UPLOADS=/data/uploads

# Repopulate the database automatically when it's empty (e.g. on an ephemeral
# free-tier disk after a redeploy). Turn off once real data exists.
# SEED_ON_BOOT=1

# Separate Kwara PostgreSQL connection. Replace with your database details.
# DATABASE_URL=postgresql://user:password@localhost:5432/kwarax10
